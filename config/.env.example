# PandaScore API
PANDASCORE_API_KEY=your_pandascore_api_key_here

# Polymarket / Web3
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET=your_polymarket_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here
WALLET_PRIVATE_KEY=your_wallet_private_key_here
CHAIN_ID=137  # Polygon mainnet

# Trading parameters
MIN_EDGE_THRESHOLD=0.05  # Minimum 5% edge to trade
MAX_POSITION_SIZE=100.0  # Max USD per position
POLL_INTERVAL_SECONDS=2  # How often to check game state
MIN_LIQUIDITY=500.0  # Minimum market liquidity to trade

# Model parameters
MODEL_PATH=src/probability_model/models/win_probability_model.pkl
FEATURE_SCALER_PATH=src/probability_model/models/feature_scaler.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/arbitrage_bot.log
